<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jank Hunter: математическое сравнение</title>
  <style>{{reportCSS .ReportStyle true}}</style>
</head>
<body data-report-style="{{.ReportStyle}}" class="{{bodyClass "math-page" .PresentationMode .AnimatedBackground}}">
<header class="hero">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">Jank Hunter · математическое сравнение</div>
      <h1>Математический анализ сравнения</h1>
      <div class="subhead">{{.Math.Title}} · создан {{.GeneratedAt}} · автономный HTML</div>
    </div>
    <div class="hero-side">
      <div class="env-card">
        <div class="env-title">Сравнение</div>
        <strong class="env-device">{{ruCount .Math.Baseline.Summary.LogCount "лог" "лога" "логов"}} → {{ruCount .Math.Candidate.Summary.LogCount "лог" "лога" "логов"}}</strong>
        <div class="env-subtitle">события данных: база {{.Math.Baseline.Summary.EventCount}} · кандидат {{.Math.Candidate.Summary.EventCount}}</div>
        <div class="env-grid">
          <div class="env-item"><div class="env-label">HTTP базы</div><div class="env-value">{{.Math.Baseline.Summary.HTTPCount}}</div><div class="env-detail">p95 {{.Math.Baseline.Summary.HTTPP95MS}} мс</div></div>
          <div class="env-item"><div class="env-label">HTTP кандидата</div><div class="env-value">{{.Math.Candidate.Summary.HTTPCount}}</div><div class="env-detail">p95 {{.Math.Candidate.Summary.HTTPP95MS}} мс</div></div>
        </div>
      </div>
      {{if or .MainReportHref .InfluenceReportHref}}<div class="hero-actions">{{if .MainReportHref}}<a class="math-link" href="{{.MainReportHref}}">← Обзор</a>{{end}}{{if .InfluenceReportHref}}<a class="math-link" href="{{.InfluenceReportHref}}">Граф влияния</a>{{end}}</div>{{end}}
    </div>
  </div>
</header>
<nav class="nav">
  {{range .Math.Sections}}<a href="#{{.ID}}">{{.Title}}</a>{{end}}
  <a href="#code-problems">Реестр кода</a>
  <a href="#memory-leaks">Утечки</a>
  <a href="#method-reference">Справка по методам</a>
</nav>
<main>
  <section id="math-overview" class="panel">
    <div class="panel-head">
      <div>
        <h2>Обзор сравнения</h2>
        <div class="panel-kicker">Сравнение рассчитано по переданным прогонам базы и кандидата. Несопоставимые или недостаточные данные отмечаются явно.</div>
      </div>
      <span class="pill">математическое сравнение</span>
    </div>
    <div class="grid">
      <div class="metric"><div class="label">События данных базы</div><div class="value">{{.Math.Baseline.Summary.EventCount}}</div><div class="hint">всего записей {{.Math.Baseline.Summary.TotalRecordCount}}{{if gt .Math.Baseline.IndependentRunCount 1}} · прогонов {{.Math.Baseline.IndependentRunCount}}{{end}}</div></div>
      <div class="metric"><div class="label">События данных кандидата</div><div class="value">{{.Math.Candidate.Summary.EventCount}}</div><div class="hint">всего записей {{.Math.Candidate.Summary.TotalRecordCount}}{{if gt .Math.Candidate.IndependentRunCount 1}} · прогонов {{.Math.Candidate.IndependentRunCount}}{{end}}</div></div>
      <div class="metric"><div class="label">Подтормаживания базы</div><div class="value">{{printf "%.2f" .Math.Baseline.Summary.UIJankPct}}%</div><div class="hint">{{.Math.Baseline.Summary.UIFrames}} кадров</div></div>
      <div class="metric"><div class="label">Подтормаживания кандидата</div><div class="value">{{printf "%.2f" .Math.Candidate.Summary.UIJankPct}}%</div><div class="hint">{{.Math.Candidate.Summary.UIFrames}} кадров</div></div>
      <div class="metric"><div class="label">{{tip "Проблемные окна" "Частота агрегированных окон причин за минуту. Значение нормировано по длительности, чтобы длинный прогон не выглядел хуже только из-за времени наблюдения."}}</div><div class="value">{{printf "%.2f" (perMinute (summaryProblemWindows .Math.Baseline.Summary) .Math.Baseline.Summary.DurationMS)}} → {{printf "%.2f" (perMinute (summaryProblemWindows .Math.Candidate.Summary) .Math.Candidate.Summary.DurationMS)}} <small>шт/мин</small></div><div class="hint">спам {{printf "%.2f" (perMinute (summaryLogSpam .Math.Baseline.Summary) .Math.Baseline.Summary.DurationMS)}} → {{printf "%.2f" (perMinute (summaryLogSpam .Math.Candidate.Summary) .Math.Candidate.Summary.DurationMS)}} выз./мин</div></div>
    </div>
    <div class="report-guide">
      <div class="guide-card"><strong>Как читать сравнение</strong>Сначала проверьте одинаковость сценариев, устройств, сети и длительности. Затем смотрите абсолютную дельту, размер выборки и уверенность вместе.</div>
      <div class="guide-card"><strong>Где искать причину</strong>После подтвержденного ухудшения найдите его время и сценарий. Граф связей дает список гипотез, но не доказывает виновника.</div>
      <div class="guide-card"><strong>Что считать выводом</strong>Один пик или новая связь — повод проверить. Для задачи на исправление нужен повторяемый эффект и подтверждение измерениями либо трассировкой.</div>
    </div>
    {{scoreGuide "compare"}}
    <details id="code-problems" class="fold code-registry-fold" open>
      <summary><span>Реестр проблем кода кандидата</span><span class="fold-summary-meta">{{ruCount (len .Math.Candidate.Summary.CodeProblems) "строка" "строки" "строк"}}</span></summary>
      <div class="fold-body">
        <p class="help-text">Показывает классы и методы кандидата, которые стали заметнее относительно базы или уже несут высокий риск. Дельта оценки помогает быстро отделить новые регрессии от старого технического долга.</p>
        {{rowLimitNote "Реестр проблем на математической странице" (len .Math.Candidate.Summary.CodeProblems) 16}}
        {{scoreGuide "code"}}
        {{with codeProblemCategories .Math.Candidate.Summary.CodeProblems}}
        <div class="registry-insights"><span class="registry-insights-label">Категории</span>{{range .}}<button type="button" class="registry-chip {{severityClass .Severity}}" data-registry-category="{{.Name}}">{{.Name}} <strong>{{.Count}}</strong></button>{{end}}</div>
        {{end}}
        {{with codeProblemSeverities .Math.Candidate.Summary.CodeProblems}}
        <div class="registry-insights"><span class="registry-insights-label">Риск</span>{{range .}}<button type="button" class="registry-chip {{severityClass .Severity}}" data-registry-severity="{{.Name}}">{{severityLabel .Name}} <strong>{{.Count}}</strong></button>{{end}}</div>
        {{end}}
        <div class="code-registry" data-code-registry>
          <div class="registry-toolbar">
            <input type="search" data-code-registry-search placeholder="Фильтр по классу, методу, экрану, сценарию, маршруту или проблеме" aria-label="Фильтр сравнительного реестра проблем кода">
            <select data-code-registry-severity aria-label="Фильтр по риску">
              <option value="">Все уровни риска</option>
              <option value="high">Критично</option>
              <option value="medium">Предупреждение</option>
              <option value="ok">Низкий риск</option>
            </select>
            <select data-code-registry-category aria-label="Фильтр по категории">
              <option value="">Все категории</option>
              {{codeProblemCategoryOptions .Math.Candidate.Summary.CodeProblems}}
            </select>
            <span class="registry-counter" data-code-registry-count></span>
          </div>
          <div class="problem-empty">По текущим фильтрам проблемных классов не найдено.</div>
          <table class="code-problem-table">
            <thead>
              <tr>
                <th><button type="button" data-code-sort="severity">Статус</button></th>
                <th><button type="button" data-code-sort="class">Класс / метод</button></th>
                <th><button type="button" data-code-sort="score">Оценка</button></th>
                <th><button type="button" data-code-sort="category">Категории</button></th>
                <th>Подробности кандидата</th>
              </tr>
            </thead>
            <tbody>
              {{range limitRows (codeProblemCompareRows .Math.Comparison) 16}}
              <tr data-code-problem-row data-score="{{printf "%.1f" .DeltaScore}}" data-severity="{{.Severity}}" data-class="{{codeProblemLocation .Candidate}}" data-categories="{{join .Candidate.Categories "|"}}">
                <td><span class="problem-score {{severityClass .Severity}}">{{severityLabel .Severity}}</span><div class="muted">{{.Status}}</div></td>
                <td><div class="problem-location"><code>{{.Candidate.ClassName}}</code>{{if .Candidate.Method}}<div class="method"><code>{{.Candidate.Method}}</code></div>{{end}}</div></td>
                <td><div>база {{printf "%.1f" .BaselineScore}}</div><div>кандидат {{printf "%.1f" .Candidate.Score}}</div><div class="muted">дельта {{printf "%+.1f" .DeltaScore}}</div></td>
                <td><div class="problem-tags">{{range .Candidate.Categories}}<span class="problem-chip">{{.}}</span>{{end}}</div><div class="muted">{{join .Candidate.Problems ", "}}</div></td>
                <td>
                  <details class="code-problem-details">
                    <summary><span class="code-problem-summary-main"><strong>Доказательства и рекомендация</strong><em>{{.Candidate.Evidence}}</em></span><small>{{ruCount (len .Candidate.Signals) "сигнал" "сигнала" "сигналов"}}{{if .Candidate.DrillDown}} · {{ruCount (len .Candidate.DrillDown) "сценарий" "сценария" "сценариев"}}{{end}}</small></summary>
                    <div class="code-problem-detail-body">
                      <div class="code-problem-detail-block span-all"><strong>Доказательство</strong><p>{{.Candidate.Evidence}}</p></div>
                      <div class="code-problem-detail-block"><strong>Контекст</strong><div class="problem-context">{{range .Candidate.Screens}}<div>экран <code>{{.}}</code></div>{{end}}{{range .Candidate.Flows}}<div>сценарий <code>{{.}}</code></div>{{end}}{{range .Candidate.Steps}}<div>шаг <code>{{.}}</code></div>{{end}}{{range .Candidate.Routes}}<div>маршрут <code>{{.}}</code></div>{{end}}</div></div>
                      <div class="code-problem-detail-block"><strong>Влияние кандидата</strong><p>{{.Candidate.Impact}}</p></div>
                      <div class="code-problem-detail-block span-all"><strong>Что проверить</strong><p>{{.Candidate.Recommendation}}</p></div>
                      {{if .Candidate.DrillDown}}<div class="code-problem-detail-block span-all"><strong>Детализация</strong>{{rowLimitNote "Сценарии этой строки" (len .Candidate.DrillDown) 3}}<div class="problem-drilldown">{{range limitRows .Candidate.DrillDown 3}}<div class="problem-drill"><strong>{{codeProblemDrillPath .}}</strong><span>Доказательство: {{.Evidence}}</span><span>Рекомендация: {{.Recommendation}}</span></div>{{end}}</div></div>{{end}}
                      <div class="code-problem-detail-block span-all"><strong>Сигналы кандидата</strong>{{rowLimitNote "Сигналы этой строки" (len .Candidate.Signals) 4}}<div class="problem-signals">{{range limitRows .Candidate.Signals 4}}<div class="problem-signal {{severityClass .Severity}}"><strong>{{.Name}}</strong><small>{{.Category}} · {{codeProblemMetric .}}<br>{{.Detail}}</small></div>{{end}}</div></div>
                    </div>
                  </details>
                </td>
              </tr>
              {{else}}<tr><td colspan="5" class="muted">Реестр проблем кода кандидата пуст: в сравнении нет привязанных к классу сигналов.</td></tr>{{end}}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    <details id="memory-leaks" class="fold code-registry-fold">
      <summary><span>Сравнение сигналов удержания памяти</span></summary>
      <div class="fold-body">
        <p class="help-text">Показывает удержанные объекты кандидата, которые появились или усилились относительно базы. Оценка учитывает количество, возраст удержания, тип объекта и наличие пользовательского держателя.</p>
        {{rowLimitNote "Сигналы удержания на математической странице" (len .Math.Candidate.Summary.MemoryLeaks) 10}}
        {{scoreGuide "leak"}}
        <div class="code-registry" data-code-registry>
          <div class="registry-toolbar">
            <input type="search" data-code-registry-search placeholder="Фильтр по удержанному объекту, держателю, экрану или рекомендации" aria-label="Фильтр сравнительного реестра утечек памяти">
            <select data-code-registry-severity aria-label="Фильтр утечек по риску">
              <option value="">Все уровни риска</option>
              <option value="high">Критично</option>
              <option value="medium">Предупреждение</option>
              <option value="ok">Низкий риск</option>
            </select>
            <select data-code-registry-category aria-label="Фильтр утечек по типу объекта">
              <option value="">Все типы</option>
              {{range leakObjectKindOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
            </select>
            <span class="registry-counter" data-code-registry-count></span>
          </div>
          <div class="problem-empty">По текущим фильтрам утечек не найдено.</div>
          <table class="code-problem-table leak-table">
            <thead>
              <tr>
                <th><button type="button" data-code-sort="severity">Риск</button></th>
                <th><button type="button" data-code-sort="class">Удержанный объект</button></th>
                <th><button type="button" data-code-sort="category">Тип</button></th>
                <th>Вероятный держатель</th>
                <th><button type="button" data-code-sort="score">Оценка</button></th>
                <th>Изменение</th>
                <th>Контекст</th>
                <th>{{tip "Оценка удержанного размера" "Ориентировочная оценка удержанного размера кандидата. Точное значение требует дампа памяти."}}</th>
                <th>{{tip "Путь / контекст удержания" "С HPROF здесь показан путь ссылок кандидата. Без HPROF — контекст обнаружения, который не доказывает утечку."}}</th>
                <th>Что проверить</th>
                <th>Доказательства</th>
              </tr>
            </thead>
            <tbody>
              {{range limitRows (memoryLeakCompareRows .Math.Comparison) 10}}
              <tr data-code-problem-row data-score="{{printf "%.1f" .DeltaScore}}" data-severity="{{.Severity}}" data-class="{{.Candidate.ClassName}}" data-categories="{{.Candidate.ObjectKind}}">
                <td><span class="problem-score {{severityClass .Severity}}">{{severityLabel .Severity}}</span><div class="muted">{{.Status}}</div></td>
                <td><div class="problem-location"><code>{{.Candidate.ClassName}}</code></div></td>
                <td><div class="leak-object-kind">{{leakObjectKindLabel .Candidate.ObjectKind}}</div>{{if .Candidate.SystemRetained}}<div class="muted">системный объект</div>{{else if .Candidate.UserOwned}}<div class="muted">пользовательский код</div>{{end}}</td>
                <td><code>{{.Candidate.Holder}}</code><div class="leak-holder-quality">{{.Candidate.HolderQuality}}</div></td>
                <td><div>база {{printf "%.1f" .BaselineScore}}</div><div>кандидат {{printf "%.1f" .Candidate.Score}}</div><div class="muted">дельта {{printf "%+.1f" .DeltaScore}}</div></td>
                <td><div>кол-во {{.BaselineCount}} → {{.Candidate.Count}} ({{printf "%+d" .DeltaCount}})</div><div>возраст {{humanDuration .BaselineAgeMS}} → {{humanDuration .Candidate.MaxAgeMS}} ({{signedDuration .DeltaAgeMS}})</div></td>
                <td><div class="problem-context">{{with reportValue .Candidate.Screen ""}}<div>экран <code>{{.}}</code></div>{{end}}{{with reportValue .Candidate.Flow ""}}<div>сценарий <code>{{.}}</code></div>{{end}}{{with reportValue .Candidate.Step ""}}<div>шаг <code>{{.}}</code></div>{{end}}</div></td>
                <td><div>{{dataSize .Candidate.EstimatedRetainedKB}}</div><div class="muted">{{.Candidate.RetainedSizeConfidence}}</div><div class="muted">{{.Candidate.RetainedSizeExplanation}}</div></td>
                <td><div class="leak-dominator">{{range .Candidate.DominatorPath}}<span>{{.}}</span>{{end}}</div><div class="muted">{{.Candidate.DominatorTreeExplanation}}</div><div class="leak-chain-summary">{{.Candidate.LeakChainSummary}}</div></td>
                <td>{{.Candidate.Recommendation}}<div class="leak-chain-actions"><strong>Быстрые проверки цепочки</strong>{{range .Candidate.LeakChainActions}}<span>{{.}}</span>{{end}}</div></td>
                <td><strong>{{.Candidate.EvidenceLabel}}</strong><div class="muted"><code>{{.Candidate.EvidenceKind}}</code> · {{.Candidate.EvidenceConfidence}}</div>{{.Candidate.Evidence}}{{range .Candidate.QualityWarnings}}<div class="warning">{{.}}</div>{{end}}</td>
              </tr>
              {{else}}<tr><td colspan="11" class="muted">У кандидата нет подозрений на утечки памяти.</td></tr>{{end}}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {{if .Math.Candidate.Summary.Influence.Available}}
    <h3>Граф влияния кандидата</h3>
    <p class="help-text">Встроенный срез показывает верхние классы кандидата, а полный граф вынесен в отдельный HTML.</p>
    <table class="timeline-table">
      <tr><th>Класс</th><th>{{tip "Оценка" (scoreHelp "influence")}}</th><th>Риск</th><th>Статус</th><th>Причины</th></tr>
      {{range topInfluenceNodes .Math.Candidate.Summary.Influence 8}}
      <tr><td><code>{{.ClassName}}</code></td><td>{{printf "%.1f" .Score}}</td><td>{{influenceSeverity .Severity}}</td><td>{{influenceStatus .Status}}</td><td>{{join .Reasons ", "}}</td></tr>
      {{end}}
    </table>
    {{if .InfluenceReportHref}}<p class="help-text"><a href="{{.InfluenceReportHref}}">Открыть подробный граф влияния кандидата</a></p>{{end}}
    {{end}}
    <h3>Сравнение сценариев и источников</h3>
    {{$flowRows := flowCompareRows .Math.Baseline.Summary .Math.Candidate.Summary}}
    {{rowLimitNote "Сравнение сценариев на математической странице" (len $flowRows) 64}}
    <table class="timeline-table">
      <tr><th>Контекст</th><th>Проблемы базы</th><th>Проблемы кандидата</th><th>Δ проблем</th><th>Спам базы</th><th>Спам кандидата</th><th>Δ спама</th><th>HTTP p95 база</th><th>HTTP p95 кандидат</th><th>UI база</th><th>UI кандидат</th><th>Серьезность</th></tr>
      {{range limitRows $flowRows 64}}
      <tr>
        <td><code>{{flowKeyHint .Screen .Flow .Step .Owner}}</code></td>
        <td>{{.BaselineProblems}}</td><td>{{.CandidateProblems}}</td><td>{{.DeltaProblems}}</td>
        <td>{{.BaselineLogSpam}}</td><td>{{.CandidateLogSpam}}</td><td>{{.DeltaLogSpam}}</td>
        <td>{{.BaselineHTTPP95MS}} мс</td><td>{{.CandidateHTTPP95MS}} мс</td>
        <td>{{printf "%.2f" .BaselineJankPct}}%</td><td>{{printf "%.2f" .CandidateJankPct}}%</td>
        <td class="{{severityClass .Severity}}">{{severityLabel .Severity}}</td>
      </tr>
      {{else}}<tr><td colspan="12" class="muted">Нет событий контекста сценария для математического сравнения.</td></tr>{{end}}
    </table>
    <h3>Находки</h3>
    <div class="finding-list">
      {{range significantMathFindings .Math.Findings}}
      <div class="finding {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div>{{if .Recommendation}}<div class="muted">{{.Recommendation}}</div>{{end}}</div>
      {{else}}<div class="muted">Нет значимых предупреждений по качеству сравнения.</div>{{end}}
    </div>
    <h3 id="section-overview" class="section-overview-heading">Сводка разделов</h3>
    <div class="section-overview-grid">
      {{range .Math.Sections}}
      <a class="section-overview-card {{severityClass .Status}}" href="#{{.ID}}">
        <div class="section-overview-title"><span>{{.Title}}</span><span class="section-status {{severityClass .Status}}">{{statusLabel .Status}}</span></div>
        <div class="section-overview-summary">{{.Summary}}</div>
      </a>
      {{end}}
    </div>
  </section>

  {{$math := .Math}}
  {{range .Math.Sections}}
  <section id="{{.ID}}" class="panel{{if eq .ID "markov"}} markov-panel{{end}}">
    <div class="panel-head">
      <div><h2>{{.Title}}</h2><div class="panel-kicker">{{.Summary}}</div></div>
      <span class="section-status {{severityClass .Status}}">{{statusLabel .Status}}</span>
    </div>
    {{if eq .ID "markov"}}
    <div class="markov-forecast-grid">
      {{with $math.Baseline.Markov.Forecast}}
      <article class="markov-forecast {{severityClass .Severity}}" data-markov-forecast="{{.Direction}}">
        <div class="markov-forecast-copy">
          <div class="markov-forecast-heading"><span>База · прогноз траектории</span><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></div>
          <strong class="markov-forecast-title">{{.Label}}</strong>
          <p>{{.Summary}}</p>
          <div class="markov-forecast-confidence">Уверенность: <strong>{{markovConfidence .Confidence}}</strong> · {{.ConfidenceReason}}</div>
        </div>
        {{if .HorizonWindows}}
        <div class="markov-forecast-metrics">
          <div><span>Начало</span><strong>{{printf "%.1f" (percent01 .EarlyBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Последняя часть</span><strong>{{printf "%.1f" (percent01 .RecentBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Прогноз</span><strong>{{printf "%.1f" (percent01 .ProjectedBadProbability)}}%</strong><small>плохого состояния</small></div>
          <div><span>Горизонт</span><strong>{{.HorizonWindows}}</strong><small>интервалов · {{humanDuration .HorizonMS}}</small></div>
        </div>
        {{end}}
      </article>
      {{end}}
      {{with $math.Candidate.Markov.Forecast}}
      <article class="markov-forecast {{severityClass .Severity}}" data-markov-forecast="{{.Direction}}">
        <div class="markov-forecast-copy">
          <div class="markov-forecast-heading"><span>Кандидат · прогноз траектории</span><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></div>
          <strong class="markov-forecast-title">{{.Label}}</strong>
          <p>{{.Summary}}</p>
          <div class="markov-forecast-confidence">Уверенность: <strong>{{markovConfidence .Confidence}}</strong> · {{.ConfidenceReason}}</div>
        </div>
        {{if .HorizonWindows}}
        <div class="markov-forecast-metrics">
          <div><span>Начало</span><strong>{{printf "%.1f" (percent01 .EarlyBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Последняя часть</span><strong>{{printf "%.1f" (percent01 .RecentBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Прогноз</span><strong>{{printf "%.1f" (percent01 .ProjectedBadProbability)}}%</strong><small>плохого состояния</small></div>
          <div><span>Горизонт</span><strong>{{.HorizonWindows}}</strong><small>интервалов · {{humanDuration .HorizonMS}}</small></div>
        </div>
        {{end}}
      </article>
      {{end}}
    </div>
    {{end}}
    <details class="fold">
      <summary>{{if eq .ID "markov"}}Методика и наблюдения{{else}}Детали раздела{{end}}</summary>
      <div class="fold-body">
        <div class="finding-list">
          {{range significantMathFindings .Findings}}
          <div class="finding {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div>{{if .Recommendation}}<div class="muted">{{.Recommendation}}</div>{{end}}</div>
          {{else}}<div class="muted">Нет значимых предупреждений в этом разделе.</div>{{end}}
        </div>
        {{if eq .ID "timeline"}}
        <h3>База</h3>
        <div class="timeline-grid">
          {{range $math.Baseline.Series}}
          <div class="timeline-chart">
            <div class="timeline-chart-head"><div class="timeline-chart-title">{{.Name}}</div><div class="timeline-chart-value">макс. {{printf "%.1f" (seriesMax .)}} {{.Unit}}</div></div>
            {{sparkline .}}
          </div>
          {{else}}<div class="muted">Нет ненулевых рядов базы для отображения.</div>{{end}}
        </div>
        <h3>Кандидат</h3>
        <div class="timeline-grid">
          {{range $math.Candidate.Series}}
          <div class="timeline-chart">
            <div class="timeline-chart-head"><div class="timeline-chart-title">{{.Name}}</div><div class="timeline-chart-value">макс. {{printf "%.1f" (seriesMax .)}} {{.Unit}}</div></div>
            {{sparkline .}}
          </div>
          {{else}}<div class="muted">Нет ненулевых рядов кандидата для отображения.</div>{{end}}
        </div>
        {{end}}
        {{if eq .ID "robust"}}
        <h3>Робастные дельты</h3>
        {{range robustDeltaGroups $math.RobustDeltas}}
        <div class="category-block">
          <h4>{{.Title}}</h4>
          <table class="timeline-table">
            <tr><th>{{tip "Статус" "Автоматическая оценка направления изменения. Для неизвестного направления gauge статус остаётся нейтральным."}}</th><th>{{tip "Имя" "Маршрут, экран, источник или gauge-метрика, для которых сопоставляются две выборки."}}</th><th>{{tip "Метрика" "Измеряемая величина и её единица."}}</th><th>{{tip "N база" "Количество наблюдений в базе. Ноль означает, что сигнал в базе отсутствует и прямое сравнение распределений невозможно."}}</th><th>{{tip "N кандидат" "Количество наблюдений у кандидата. Сильно разные N могут означать, что сценарии выполнены не одинаково."}}</th><th>{{tip "p95 база" "Уровень, который не превышают 95% наблюдений базы."}}</th><th>{{tip "p95 кандидат" "Уровень, который не превышают 95% наблюдений кандидата."}}</th><th>{{tip "Δ p95" "Абсолютная разница p95: кандидат минус база, в исходных единицах метрики."}}</th><th>{{tip "Δ%" "Относительное изменение к базе. Если база равна нулю или сигнал есть только в одном прогоне, процент не рассчитывается."}}</th><th>{{tip "Дельта Клиффа" "Показывает, как часто значение кандидата больше значения базы: от −1 до 1. Рассчитывается только когда обе выборки существуют. Это размер эффекта, а не вероятность ошибки."}}</th><th>{{tip "Эффект" "Словесная категория абсолютной дельты Клиффа: пренебрежимый, малый, средний или большой размер различия."}}</th><th>{{tip "Доверие" (scoreHelp "confidence")}}</th><th>{{tip "Вывод" "Человекочитаемое резюме сравнения с явной причиной, если автоматический вердикт отключён."}}</th></tr>
            {{range .Items}}
            <tr>
              <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
              <td><code>{{.Name}}</code></td><td>{{.Metric}}</td><td>{{.BaselineCount}}</td><td>{{.CandidateCount}}</td>
              <td>{{if gt .BaselineCount 0}}{{printf "%.1f" .BaselineP95}} {{.Unit}}{{else}}<span class="muted">нет выборки</span>{{end}}</td><td>{{if gt .CandidateCount 0}}{{printf "%.1f" .CandidateP95}} {{.Unit}}{{else}}<span class="muted">нет выборки</span>{{end}}</td><td>{{printf "%+.1f" .P95Delta}} {{.Unit}}</td><td>{{if .DeltaPctAvailable}}{{printf "%+.1f" .P95DeltaPct}}%{{else}}<span class="muted">не применимо</span>{{end}}</td>
              <td>{{if .Comparable}}{{printf "%.3f" .CliffDelta}}{{else}}<span class="muted">не применимо</span>{{end}}</td><td>{{.EffectSize}}</td><td>{{.Confidence}}</td><td>{{.Summary}}</td>
            </tr>
            {{end}}
          </table>
        </div>
        {{else}}<div class="muted">Недостаточно пересекающихся распределений для робастного сравнения.</div>{{end}}
        <p class="muted">Положительная дельта Клиффа означает только то, что значения кандидата чаще больше базы. Для известных задержек, пауз и PSS это ухудшение; для пользовательской gauge-метрики направление неизвестно и автоматический вердикт не ставится.</p>
        {{end}}
        {{if eq .ID "change-points"}}
        <h3>Изменения точек изменения</h3>
        <p class="help-text">Точки сопоставляются по сигналу и близкому месту сценария: по времени либо по относительной позиции в прогоне. Это уменьшает ложные «новые точки», когда одинаковый шаг выполнялся с разной скоростью.</p>
        <table class="timeline-table">
          <tr><th>Статус</th><th>Сигнал</th><th>Время базы</th><th>Время кандидата</th><th>{{tip "Оценка базы" (scoreHelp "change")}}</th><th>{{tip "Оценка кандидата" (scoreHelp "change")}}</th><th>Вывод</th></tr>
          {{range $math.ChangeDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{.Status}}</span></td><td>{{.Signal}}</td>
            <td>{{if .BaselineTime}}{{printf "%.1fs" (seconds .BaselineTime)}}{{else}}-{{end}}</td>
            <td>{{if .CandidateTime}}{{printf "%.1fs" (seconds .CandidateTime)}}{{else}}-{{end}}</td>
            <td>{{printf "%.2f" .BaselineScore}}</td><td><div>{{printf "%.2f" .CandidateScore}}</div><div class="bar"><i style="{{scoreWidth .CandidateScore}}"></i></div></td>
            <td>{{.Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="7" class="muted">Новых, исчезнувших или усилившихся точек изменения не найдено.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "periodic"}}
        <h3>База</h3>
        <table class="timeline-table">
          <tr><th>Сигнал</th><th>{{tip "N" "Самый длинный непрерывный участок с измерениями; ниже показано покрытие всего ряда. Пропуски не заменяются нулями."}}</th><th>{{tip "Первый лаг" "Первый сдвиг с автокорреляцией от 0.60. Отсутствие значения означает, что повторяемость не подтверждена этим тестом."}}</th><th>{{tip "Энтропия" "Ближе к 0 — узкий ритм, ближе к 1 — шум. Энтропия не измеряет серьезность проблемы."}}</th><th>{{tip "Пики" "Только локальные спектральные пики, минимум втрое выше фона и с достаточной уверенностью."}}</th><th>Вывод</th></tr>
          {{range $math.Baseline.Periodic}}
          <tr><td>{{.Signal}}</td><td>{{.SampleCount}}<div class="muted">измерено {{.ObservedBucketCount}} из {{.TotalBucketCount}}</div>{{if .Approximated}}<div class="muted">спектр: {{.AnalyzedSampleCount}}, шаг {{printf "%.1fs" (seconds .AnalysisBucketMS)}}</div>{{end}}</td><td>{{if .FirstSignificantLagMS}}{{printf "%.1fs" (seconds .FirstSignificantLagMS)}}{{else}}<span class="muted">не подтвержден</span>{{end}}</td><td>{{if ge .SampleCount 12}}{{printf "%.2f" .SpectralEntropy}}{{else}}<span class="muted">не рассчитана</span>{{end}}</td><td>{{range .Peaks}}<div>{{printf "%.1fs" (seconds .PeriodMS)}} · уверенность {{printf "%.2f" .Confidence}}</div>{{else}}<span class="muted">нет подтвержденных</span>{{end}}</td><td>{{.Summary}}</td></tr>
          {{else}}<tr><td colspan="6" class="muted">Недостаточно данных базы.</td></tr>{{end}}
        </table>
        <h3>Кандидат</h3>
        <table class="timeline-table">
          <tr><th>Сигнал</th><th>{{tip "N" "Самый длинный непрерывный участок с измерениями; ниже показано покрытие всего ряда."}}</th><th>{{tip "Первый лаг" "Первый сдвиг с автокорреляцией от 0.60."}}</th><th>{{tip "Энтропия" "Ближе к 0 — узкий ритм, ближе к 1 — шум. Это не оценка серьезности."}}</th><th>{{tip "Пики" "Слабые пики, похожие на фон, скрываются."}}</th><th>Вывод</th></tr>
          {{range $math.Candidate.Periodic}}
          <tr><td>{{.Signal}}</td><td>{{.SampleCount}}<div class="muted">измерено {{.ObservedBucketCount}} из {{.TotalBucketCount}}</div>{{if .Approximated}}<div class="muted">спектр: {{.AnalyzedSampleCount}}, шаг {{printf "%.1fs" (seconds .AnalysisBucketMS)}}</div>{{end}}</td><td>{{if .FirstSignificantLagMS}}{{printf "%.1fs" (seconds .FirstSignificantLagMS)}}{{else}}<span class="muted">не подтвержден</span>{{end}}</td><td>{{if ge .SampleCount 12}}{{printf "%.2f" .SpectralEntropy}}{{else}}<span class="muted">не рассчитана</span>{{end}}</td><td>{{range .Peaks}}<div>{{printf "%.1fs" (seconds .PeriodMS)}} · уверенность {{printf "%.2f" .Confidence}}</div>{{else}}<span class="muted">нет подтвержденных</span>{{end}}</td><td>{{.Summary}}</td></tr>
          {{else}}<tr><td colspan="6" class="muted">Недостаточно данных кандидата.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "network-loops"}}
        <h3>Изменения кандидатов сетевых циклов</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Новый, исчезнувший, усилившийся или ослабевший кандидат сетевого цикла."}}</th><th>{{tip "Маршрут" "Размеченный сетевой маршрут кандидата цикла. Пустое значение означает, что маршрут не удалось атрибутировать."}}</th><th>{{tip "Источник" "Размеченный источник сетевой работы. Это контекст для проверки, а не автоматически виновный код."}}</th><th>{{tip "Период базы" "Оценённое типичное расстояние между всплесками в базе."}}</th><th>{{tip "Период кандидата" "Оценённое типичное расстояние между всплесками у кандидата."}}</th><th>{{tip "Нагрузка базы" (scoreHelp "network_burn")}}</th><th>{{tip "Нагрузка кандидата" (scoreHelp "network_burn")}}</th><th>{{tip "Δ нагрузки" "Условная нагрузка кандидата минус база. Единица не является временем, байтами или энергией."}}</th><th>{{tip "Δ уверенности" "Насколько изменилась поддержка повторяемого паттерна несколькими признаками. Это не изменение вероятности бага."}}</th><th>{{tip "Вывод" "Кратко описывает тип изменения и напоминает об ограничениях детектора."}}</th></tr>
          {{range $math.NetworkLoopDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{.Status}}</span></td>
            <td>{{if .Route}}<code>{{.Route}}</code>{{else}}<span class="muted">нет</span>{{end}}</td>
            <td>{{if .Owner}}<code>{{contextHint .Owner "owner"}}</code>{{else}}<span class="muted">нет</span>{{end}}</td>
            <td>{{if .BaselinePeriodMS}}{{printf "%.1fs" (seconds .BaselinePeriodMS)}}{{else}}-{{end}}</td>
            <td>{{if .CandidatePeriodMS}}{{printf "%.1fs" (seconds .CandidatePeriodMS)}}{{else}}-{{end}}</td>
            <td>{{printf "%.1f" .BaselineBurn}}</td>
            <td>{{printf "%.1f" .CandidateBurn}}</td>
            <td>{{printf "%+.1f" .BurnDelta}}</td>
            <td>{{printf "%+.2f" .ConfidenceDelta}}</td>
            <td>{{.Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="10" class="muted">Заметных изменений кандидатов сетевых циклов не найдено.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "integral"}}
        <h3>Дельты интегральных оценок</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Регрессия рассчитывается только для сопоставимой длительности и одинакового числа независимых прогонов."}}</th><th>{{tip "Оценка" (scoreHelp "integral")}}</th><th>{{tip "База" "Накопленное значение, длительность и число независимых прогонов базы."}}</th><th>{{tip "Кандидат" "Накопленное значение, длительность и число независимых прогонов кандидата."}}</th><th>{{tip "Δ" "Абсолютная разница: кандидат минус база, в единице конкретной оценки."}}</th><th>{{tip "Δ%" "Процент относительно базы. Если база равна нулю, число прогонов различается или длительность отличается больше чем на 20%, процент не имеет честного смысла и не показывается."}}</th><th>{{tip "Критерии" "Стартовые инженерные диапазоны статуса, а не универсальный SLA продукта."}}</th><th>{{tip "Формула" "Правило расчёта. У каждой строки своя единица; Σ означает суммирование по временным интервалам."}}</th><th>{{tip "Вывод" "Поясняет изменение или точную причину, почему автоматический вердикт отключён."}}</th></tr>
          {{range $math.IntegralDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Title}}</td>
            <td>{{printf "%.1f" .BaselineValue}} {{.Unit}}<div class="muted">{{printf "%.1fs" (seconds .BaselineDurationMS)}} · прогонов {{if gt .BaselineRunCount 0}}{{.BaselineRunCount}}{{else}}1{{end}}</div></td>
            <td>{{printf "%.1f" .CandidateValue}} {{.Unit}}<div class="muted">{{printf "%.1fs" (seconds .CandidateDurationMS)}} · прогонов {{if gt .CandidateRunCount 0}}{{.CandidateRunCount}}{{else}}1{{end}}</div></td>
            <td>{{printf "%+.1f" .Delta}} {{.Unit}}</td>
            <td>{{if .DeltaPctAvailable}}{{printf "%+.1f" .DeltaPct}}%{{else}}<span class="muted">не применимо</span>{{end}}</td>
            <td>{{integralCriteria .ID}}</td>
            <td><code>{{.Formula}}</code></td>
            <td>{{.Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="9" class="muted">Интегральные дельты недоступны.</td></tr>{{end}}
        </table>
        <p class="help-text">Интегральные оценки зависят от длительности. Если база и кандидат выполняли разные сценарии или работали разное время, дельта описывает эти прогоны, но не доказывает регрессию кода.</p>
        {{end}}
        {{if eq .ID "markov"}}
        <h3>Дельты марковских метрик</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Предупреждение означает ухудшение сопоставимой метрики или невозможность честно сравнить последовательности."}}</th><th>{{tip "Метрика" "Конкретная характеристика марковской модели: экспозиция плохих состояний, восстановление, переходы или расхождение матриц."}}</th><th>{{tip "База" "Наблюдаемое значение марковской метрики в базовом прогоне."}}</th><th>{{tip "Кандидат" "Наблюдаемое значение той же метрики у кандидата."}}</th><th>{{tip "Δ" "Кандидат минус база. В колонке «Вывод» явно указано, какое направление для этой метрики хуже."}}</th><th>{{tip "Вывод" "Объясняет направление изменения или сообщает, почему марковские дельты не рассчитаны."}}</th></tr>
          {{range significantMarkovDeltas $math.MarkovDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Metric}}</td>
            <td>{{if .BaselineAvailable}}{{printf "%.1f" .BaselineValue}} {{.Unit}}{{else}}<span class="muted">нет данных</span>{{end}}</td>
            <td>{{if .CandidateAvailable}}{{printf "%.1f" .CandidateValue}} {{.Unit}}{{else}}<span class="muted">нет данных</span>{{end}}</td>
            <td>{{if .Comparable}}{{printf "%+.1f" .Delta}} {{.Unit}}{{else}}<span class="muted">не применимо</span>{{end}}</td>
            <td>{{.Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="6" class="muted">Нет значимых марковских дельт.</td></tr>{{end}}
          {{if hiddenMarkovDeltas $math.MarkovDeltas}}<tr><td colspan="6" class="muted">Скрыто спокойных марковских дельт: {{hiddenMarkovDeltas $math.MarkovDeltas}}.</td></tr>{{end}}
        </table>
        <h3>Экспозиция плохих состояний кандидата</h3>
        <table class="timeline-table">
          <tr><th>Состояние</th><th>{{tip "Доля времени" "Доля длительности кандидата, классифицированная как это плохое состояние."}}</th><th>Длительность</th><th>Интервалы</th></tr>
          {{range $math.Candidate.Markov.StateExposures}}
          <tr><td>{{markovState .State}}</td><td>{{printf "%.1f" (percent01 .Exposure)}}%</td><td>{{humanDuration .DurationMS}}</td><td>{{.Windows}}</td></tr>
          {{else}}<tr><td colspan="4" class="muted">У кандидата нет плохих состояний.</td></tr>{{end}}
        </table>
        <h3>Контекстная липкость кандидата</h3>
        <table class="timeline-table">
          <tr><th>Состояние</th><th>Контекст</th><th>{{tip "Количество" "Число самопереходов плохого состояния рядом с этим контекстом."}}</th><th>{{tip "Вероятность" "Наблюдаемая доля самопереходов. На малой выборке нестабильна и не является общей вероятностью бага."}}</th></tr>
          {{if $math.Candidate.Markov.SequenceComparable}}{{range $math.Candidate.Markov.ContextStickyStates}}
          <tr><td>{{markovState .State}}</td><td>{{.Context}}</td><td>{{.Count}}</td><td>{{printf "%.1f" (percent01 .Probability)}}%</td></tr>
          {{else}}<tr><td colspan="4" class="muted">У кандидата нет липких контекстов.</td></tr>{{end}}{{else}}<tr><td colspan="4" class="muted">Не рассчитывается для объединённых независимых прогонов кандидата.</td></tr>{{end}}
        </table>
        <h3>Переходы кандидата</h3>
        <table class="timeline-table">
          <tr><th>Из</th><th>В</th><th>{{tip "Количество" "Число наблюдавшихся переходов между соседними интервалами кандидата."}}</th><th>{{tip "Вероятность" "Доля этого перехода среди всех переходов из исходного состояния кандидата."}}</th></tr>
          {{if $math.Candidate.Markov.SequenceComparable}}{{range significantMarkovTransitions $math.Candidate.Markov.Transitions}}
          <tr><td>{{markovState .From}}</td><td>{{markovState .To}}</td><td>{{.Count}}</td><td>{{printf "%.1f" (percent01 .Probability)}}%</td></tr>
          {{else}}<tr><td colspan="4" class="muted">Нет значимых переходов кандидата между состояниями деградации.</td></tr>{{end}}
          {{if hiddenMarkovTransitions $math.Candidate.Markov.Transitions}}<tr><td colspan="4" class="muted">Скрыто спокойных переходов кандидата: {{hiddenMarkovTransitions $math.Candidate.Markov.Transitions}}.</td></tr>{{end}}{{else}}<tr><td colspan="4" class="muted">Хронологические переходы не рассчитываются для объединённых независимых прогонов кандидата.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "graph"}}
        <h3>Визуальный граф связей кандидата</h3>
        <p class="help-text">Линии показывают совместные наблюдения без направления причины. Обратные дубликаты скрыты.</p>
        {{causalGraphSVG $math.Candidate.CausalGraph}}
        <h3>Изменения графа связей и гипотез</h3>
        <table class="timeline-table">
          <tr><th>Статус</th><th>Тип изменения</th><th>{{tip "База" "Значение зависит от типа строки: уверенность связи, условная стоимость цепочки или оценка связи источника. Это не единая физическая метрика."}}</th><th>{{tip "Кандидат" "Сопоставимое условное значение кандидата для этого типа строки."}}</th><th>Δ</th><th>Вывод и ограничение</th></tr>
          {{range $math.CausalDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Kind}}</td>
            <td>{{printf "%.2f" .BaselineValue}}</td>
            <td>{{printf "%.2f" .CandidateValue}}</td>
            <td>{{printf "%+.2f" .Delta}}</td>
            <td>{{.Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="6" class="muted">Заметных изменений графа не найдено.</td></tr>{{end}}
        </table>
        <h3>Цепочки от симптомов у кандидата</h3>
        <table class="timeline-table">
          <tr><th>Симптом</th><th>Контекст</th><th>Цепочка связей</th><th>{{tip "Условная стоимость" (scoreHelp "path_cost")}}</th><th>{{tip "Уверенность" "Сила цепочки совместных наблюдений. Не является вероятностью причины."}}</th></tr>
          {{range $math.Candidate.CausalGraph.Paths}}
          <tr><td>{{.From}}</td><td>{{.To}}</td><td>{{join .Nodes " ↔ "}}</td><td>{{printf "%.2f" .Cost}}</td><td>{{printf "%.2f" .Confidence}}</td></tr>
          {{else}}<tr><td colspan="5" class="muted">Кратчайшие пути кандидата не найдены.</td></tr>{{end}}
        </table>
        {{end}}
      </div>
    </details>
  </section>
  {{end}}
  <section id="method-reference" class="panel">
    <div class="panel-head">
      <div>
        <h2>Справка по методам</h2>
        <div class="panel-kicker">Что именно измеряет каждый математический метод, как считается результат и как читать дельты между базой и кандидатом.</div>
      </div>
      <span class="pill">объяснимость</span>
    </div>
    <div class="method-reference-grid">
      {{range .MethodReferences}}
      <details class="fold method-reference-card" id="method-{{.ID}}">
        <summary><span>{{.Title}}</span><span class="method-kind">{{.Kind}}</span></summary>
        <div class="fold-body">
          <div class="reference-block"><strong>Что измеряет</strong>{{.Measures}}</div>
          <div class="reference-block"><strong>Где применяется</strong>{{.AppliesTo}}</div>
          <div class="reference-block"><strong>Как считается</strong>{{.Calculation}}</div>
          <div class="reference-block"><strong>Как читать</strong>{{.Interpretation}}</div>
          <div class="reference-block"><strong>Ограничения</strong>{{.Limitations}}</div>
          <div class="reference-block"><strong>Поля в inspect</strong><div class="reference-list">{{range .InspectFields}}<code>{{.}}</code>{{end}}</div></div>
          <div class="reference-block"><strong>Поля в compare</strong><div class="reference-list">{{range .CompareFields}}<code>{{.}}</code>{{end}}</div></div>
        </div>
      </details>
      {{end}}
    </div>
  </section>
  {{with compareMathHeuristic .Math}}
  <section id="math-verdict" class="panel">
    <div class="panel-head">
      <div>
        <h2>Итоговая эвристика сравнения</h2>
        <div class="panel-kicker">Сводка по математическим дельтам: общий риск кандидата, главные факторы и первый шаг расследования.</div>
      </div>
      <span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span>
    </div>
    <div class="analysis-banner {{severityClass .Severity}}">
      <div class="eyebrow">Общий вывод</div>
      <div class="analysis-status">{{.Status}}</div>
      <div class="muted">{{.Summary}}</div>
    </div>
    <div class="heuristic-grid">
      {{range .Cards}}
      <div class="heuristic-card {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div></div>
      {{end}}
    </div>
  </section>
  {{end}}
</main>
<script>{{reportJS}}
(() => {
  const links = Array.from(document.querySelectorAll('.math-page .nav a'));
  const setActive = (hash) => {
    links.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === hash));
  };
  links.forEach((link) => link.addEventListener('click', () => setActive(link.getAttribute('href'))));
  if (location.hash) setActive(location.hash);
  const sections = links.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActive('#' + visible.target.id);
    }, { rootMargin: '-20% 0px -65% 0px', threshold: [0.1, 0.3, 0.6] });
    sections.forEach((section) => observer.observe(section));
  }
})();
</script>
</body>
</html>
