<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jank Hunter: математическое сравнение</title>
  <style>{{reportCSS true}}</style>
</head>
<body class="{{bodyClass "math-page" .PresentationMode .AnimatedBackground}}">
<header class="hero">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">Jank Hunter · математическое сравнение</div>
      <h1>Математический анализ сравнения</h1>
      <div class="subhead">{{.Math.Title}} · создан {{.GeneratedAt}}</div>
    </div>
    <div class="hero-side">
      <div class="env-card">
        <div class="env-title">Сравнение</div>
        <strong class="env-device">{{ruCount .Math.Baseline.Summary.LogCount "лог" "лога" "логов"}} → {{ruCount .Math.Candidate.Summary.LogCount "лог" "лога" "логов"}}</strong>
        <div class="env-subtitle">события данных: база {{.Math.Baseline.Summary.EventCount}} · проверяемый прогон {{.Math.Candidate.Summary.EventCount}}</div>
        <div class="env-grid">
          <div class="env-item"><div class="env-label">HTTP базы</div><div class="env-value">{{.Math.Baseline.Summary.HTTPCount}}</div><div class="env-detail">верхние 5% {{.Math.Baseline.Summary.HTTPP95MS}} мс</div></div>
          <div class="env-item"><div class="env-label">HTTP проверяемого</div><div class="env-value">{{.Math.Candidate.Summary.HTTPCount}}</div><div class="env-detail">p95 {{.Math.Candidate.Summary.HTTPP95MS}} мс</div></div>
        </div>
      </div>
      {{if or .MainReportHref .InfluenceReportHref}}<div class="hero-actions">{{if .MainReportHref}}<a class="math-link" href="{{.MainReportHref}}">← Обзор</a>{{end}}{{if .InfluenceReportHref}}<a class="math-link" href="{{.InfluenceReportHref}}">Граф влияния</a>{{end}}</div>{{end}}
    </div>
  </div>
</header>
<nav class="nav">
  <a href="#data-quality">Техническая справка</a>
  {{range .Math.Sections}}<a href="#{{.ID}}">{{.Title}}</a>{{end}}
  <a href="#code-problems">Реестр кода</a>
  <a href="#memory-leaks">Утечки</a>
  <a href="#method-reference">Справка по методам</a>
</nav>
<main>
  <section id="math-overview" class="panel">
    <div class="panel-head">
      <div>
        <h2>Обзор сравнения</h2>
        <div class="panel-kicker">Сравнение базы и проверяемого прогона по одинаковым показателям и единицам измерения.</div>
      </div>
      <span class="pill">математическое сравнение</span>
    </div>
    <div class="grid">
      <div class="metric"><div class="label">События данных базы</div><div class="value">{{.Math.Baseline.Summary.EventCount}}</div><div class="hint">всего записей {{.Math.Baseline.Summary.TotalRecordCount}}{{if gt .Math.Baseline.IndependentRunCount 1}} · групп сбора {{.Math.Baseline.IndependentRunCount}}{{end}}</div></div>
      <div class="metric"><div class="label">События проверяемого прогона</div><div class="value">{{.Math.Candidate.Summary.EventCount}}</div><div class="hint">всего записей {{.Math.Candidate.Summary.TotalRecordCount}}{{if gt .Math.Candidate.IndependentRunCount 1}} · групп сбора {{.Math.Candidate.IndependentRunCount}}{{end}}</div></div>
      <div class="metric"><div class="label">Подтормаживания базы</div><div class="value">{{printf "%.2f" .Math.Baseline.Summary.UIJankPct}}%</div><div class="hint">{{.Math.Baseline.Summary.UIFrames}} кадров</div></div>
      <div class="metric"><div class="label">Подтормаживания проверяемого</div><div class="value">{{printf "%.2f" .Math.Candidate.Summary.UIJankPct}}%</div><div class="hint">{{.Math.Candidate.Summary.UIFrames}} кадров</div></div>
      <div class="metric"><div class="label">{{tip "Проблемные окна" "Частота интервалов с проблемами за минуту. Длинный прогон не выглядит хуже только из-за большей длительности."}}</div><div class="value">{{printf "%.2f" (perMinute (summaryProblemWindows .Math.Baseline.Summary) .Math.Baseline.Summary.DurationMS)}} → {{printf "%.2f" (perMinute (summaryProblemWindows .Math.Candidate.Summary) .Math.Candidate.Summary.DurationMS)}} <small>шт/мин</small></div><div class="hint">лишние логи {{printf "%.2f" (perMinute (summaryLogSpam .Math.Baseline.Summary) .Math.Baseline.Summary.DurationMS)}} → {{printf "%.2f" (perMinute (summaryLogSpam .Math.Candidate.Summary) .Math.Candidate.Summary.DurationMS)}} выз./мин</div></div>
    </div>
    <div class="report-guide">
      <div class="guide-card"><strong>Как читать сравнение</strong>Сначала проверьте сценарий, устройство, сеть и длительность. Затем вместе оцените изменение, количество данных и надёжность.</div>
      <div class="guide-card"><strong>Где искать причину</strong>После подтвержденного ухудшения найдите его время и сценарий. Граф связей дает список гипотез, но не доказывает виновника.</div>
      <div class="guide-card"><strong>Что считать выводом</strong>Один пик или новая связь - повод проверить. Для задачи на исправление нужен повторяемый эффект и подтверждение измерениями либо трассировкой.</div>
    </div>
    {{scoreGuide "compare"}}
    <details id="code-problems" class="fold code-registry-fold" open>
      <summary><span>Проблемы кода проверяемого прогона</span><span class="fold-summary-meta">{{ruCount (len .Math.Candidate.Summary.CodeProblems) "строка" "строки" "строк"}}</span></summary>
      <div class="fold-body">
        <p class="help-text">Показывает классы и методы, которые стали проблемнее относительно базы. Изменение оценки помогает отделить новые регрессии от старого технического долга.</p>
        {{scoreGuide "code"}}
        {{with codeProblemCategories .Math.Candidate.Summary.CodeProblems}}
        <div class="registry-insights"><span class="registry-insights-label">Категории</span>{{range .}}<button type="button" class="registry-chip {{severityClass .Severity}}" data-registry-category="{{.Name}}">{{.Name}} <strong>{{.Count}}</strong></button>{{end}}</div>
        {{end}}
        {{with codeProblemSeverities .Math.Candidate.Summary.CodeProblems}}
        <div class="registry-insights"><span class="registry-insights-label">Риск</span>{{range .}}<button type="button" class="registry-chip {{severityClass .Severity}}" data-registry-severity="{{.Name}}">{{severityLabel .Name}} <strong>{{.Count}}</strong></button>{{end}}</div>
        {{end}}
        <div class="code-registry" data-code-registry data-code-problem-mode="compare">
          <div class="registry-toolbar">
            <input type="search" data-code-registry-search placeholder="Фильтр по классу, методу, экрану, сценарию, маршруту или проблеме" aria-label="Фильтр сравнительного реестра проблем кода">
            <select data-code-registry-severity aria-label="Фильтр по риску">
              <option value="">Все уровни риска</option>
              <option value="high">Критично</option>
              <option value="medium">Предупреждение</option>
              <option value="ok">Низкий риск</option>
            </select>
            <select data-code-registry-category aria-label="Фильтр по категории">
              <option value="">Все категории</option>
              {{codeProblemCategoryOptions .Math.Candidate.Summary.CodeProblems}}
            </select>
            <span class="registry-counter" data-code-registry-count></span>
          </div>
          <div class="problem-empty">По текущим фильтрам проблемных классов не найдено.</div>
          <table class="code-problem-table">
            <thead>
              <tr>
                <th><button type="button" data-code-sort="severity">Статус</button></th>
                <th><button type="button" data-code-sort="class">Класс / метод</button></th>
                <th><button type="button" data-code-sort="score">Оценка</button></th>
                <th><button type="button" data-code-sort="category">Категории</button></th>
                <th>Данные проверяемого прогона</th>
              </tr>
            </thead>
            <tbody>
              {{$codeRows := codeProblemCompareRows .Math.Comparison}}
              {{range limitRows $codeRows 50}}
              <tr data-code-problem-row data-score="{{printf "%.1f" .DeltaScore}}" data-severity="{{.Severity}}" data-class="{{codeProblemLocation .Candidate}}" data-categories="{{join .Candidate.Categories "|"}}">
                <td><span class="problem-score {{severityClass .Severity}}">{{severityLabel .Severity}}</span><div class="muted">{{.Status}}</div></td>
                <td><div class="problem-location"><code>{{.Candidate.ClassName}}</code>{{if .Candidate.Method}}<div class="method"><code>{{.Candidate.Method}}</code></div>{{end}}</div></td>
                <td><div>база {{printf "%.1f" .BaselineScore}}</div><div>проверяемый {{printf "%.1f" .Candidate.Score}}</div><div class="muted">изменение {{printf "%+.1f" .DeltaScore}}</div></td>
                <td><div class="problem-tags">{{range .Candidate.Categories}}<span class="problem-chip">{{.}}</span>{{end}}</div><div class="muted">{{join .Candidate.Problems ", "}}</div></td>
                <td>
                  <details class="code-problem-details" data-code-problem-evidence-key="{{codeProblemEvidenceKey .Candidate}}">
                    <summary><span class="code-problem-summary-main"><strong>Доказательства и рекомендация</strong><em>{{.Candidate.Evidence}}</em></span><small>{{ruCount (len .Candidate.Signals) "сигнал" "сигнала" "сигналов"}}{{if .Candidate.DrillDown}} · {{ruCount (len .Candidate.DrillDown) "сценарий" "сценария" "сценариев"}}{{end}}</small></summary>
                    <div class="code-problem-detail-body" data-code-problem-evidence-body data-impact-label="Влияние в проверяемом прогоне" data-signals-label="Сигналы проверяемого прогона"><div class="code-problem-detail-block span-all"><strong>Все подтверждающие данные</strong><p>Откройте строку, чтобы увидеть сигналы и связанные сценарии.</p></div></div>
                  </details>
                </td>
              </tr>
              {{else}}<tr><td colspan="5" class="muted">Нет проблем, связанных с конкретным классом.</td></tr>{{end}}
              {{if gt (len $codeRows) 50}}<tr class="deferred-table-loader" data-code-problem-loader data-deferred-total="{{len $codeRows}}" data-deferred-loaded="50"><th colspan="5"><button type="button" class="deferred-table-button" data-load-more-code-problems>Показать ещё 50</button><span data-deferred-remaining>Осталось строк: {{sub (len $codeRows) 50}}</span><span class="sr-only"> в математическом сравнительном реестре проблем кода</span></th></tr>{{end}}
            </tbody>
          </table>
          <script type="application/octet-stream" data-code-problem-evidence-archive data-encoding="gzip-base64url">{{codeProblemCompareArchive .Math.Comparison}}</script>
        </div>
      </div>
    </details>
    <details id="memory-leaks" class="fold code-registry-fold">
      <summary><span>Сравнение сигналов удержания памяти</span></summary>
      <div class="fold-body">
        {{if .LeakReportHref}}
        <p class="help-text">Подробное сравнение удержаний открыто в отдельном разделе, поэтому этот большой реестр здесь не повторяется.</p>
        <p><a class="math-link" href="{{.LeakReportHref}}">Открыть сравнение удержаний памяти</a></p>
        {{else}}
        <p class="help-text">Показывает удержанные объекты, которые появились или усилились относительно базы. Оценка учитывает количество, возраст, тип объекта и известного держателя.</p>
        {{scoreGuide "leak"}}
        <div class="code-registry" data-code-registry>
          <div class="registry-toolbar">
            <input type="search" data-code-registry-search placeholder="Фильтр по удержанному объекту, держателю, экрану или рекомендации" aria-label="Фильтр сравнительного реестра утечек памяти">
            <select data-code-registry-severity aria-label="Фильтр утечек по риску">
              <option value="">Все уровни риска</option>
              <option value="high">Критично</option>
              <option value="medium">Предупреждение</option>
              <option value="ok">Низкий риск</option>
            </select>
            <select data-code-registry-category aria-label="Фильтр утечек по типу объекта">
              <option value="">Все типы</option>
              {{range leakObjectKindOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
            </select>
            <span class="registry-counter" data-code-registry-count></span>
          </div>
          <div class="problem-empty">По текущим фильтрам утечек не найдено.</div>
          <table class="code-problem-table leak-table">
            <thead>
              <tr>
                <th><button type="button" data-code-sort="severity">Риск</button></th>
                <th><button type="button" data-code-sort="class">Удержанный объект</button></th>
                <th><button type="button" data-code-sort="category">Тип</button></th>
                <th>Вероятный держатель</th>
                <th><button type="button" data-code-sort="score">Оценка</button></th>
                <th>Изменение</th>
                <th>Контекст</th>
                <th>{{tip "Оценка удержанного размера" "Примерная оценка для проверяемого прогона. Точный размер можно получить только из дампа памяти."}}</th>
                <th>{{tip "Путь / контекст удержания" "С HPROF показан путь ссылок. Без HPROF показан только контекст обнаружения, и он сам по себе не доказывает утечку."}}</th>
                <th>Что проверить</th>
                <th>Доказательства</th>
              </tr>
            </thead>
            <tbody>
              {{range memoryLeakCompareRows .Math.Comparison}}
              <tr data-code-problem-row data-score="{{printf "%.1f" .DeltaScore}}" data-severity="{{.Severity}}" data-class="{{.Candidate.ClassName}}" data-categories="{{.Candidate.ObjectKind}}">
                <td><span class="problem-score {{severityClass .Severity}}">{{severityLabel .Severity}}</span><div class="muted">{{.Status}}</div></td>
                <td><div class="problem-location"><code>{{.Candidate.ClassName}}</code></div></td>
                <td><div class="leak-object-kind">{{leakObjectKindLabel .Candidate.ObjectKind}}</div>{{if .Candidate.SystemRetained}}<div class="muted">системный объект</div>{{else if .Candidate.UserOwned}}<div class="muted">пользовательский код</div>{{end}}</td>
                <td><code>{{.Candidate.Holder}}</code><div class="leak-holder-quality">{{.Candidate.HolderQuality}}</div></td>
                <td><div>база {{printf "%.1f" .BaselineScore}}</div><div>проверяемый {{printf "%.1f" .Candidate.Score}}</div><div class="muted">изменение {{printf "%+.1f" .DeltaScore}}</div></td>
                <td><div>кол-во {{.BaselineCount}} → {{.Candidate.Count}} ({{printf "%+d" .DeltaCount}})</div><div>возраст {{humanDuration .BaselineAgeMS}} → {{humanDuration .Candidate.MaxAgeMS}} ({{signedDuration .DeltaAgeMS}})</div></td>
                <td><div class="problem-context">{{with reportValue .Candidate.Screen ""}}<div>экран <code>{{.}}</code></div>{{end}}{{with reportValue .Candidate.Operation ""}}<div>операция <code>{{.}}</code></div>{{end}}</div></td>
                <td><div>{{dataSize .Candidate.EstimatedRetainedKB}}</div><div class="muted">{{.Candidate.RetainedSizeConfidence}}</div><div class="muted">{{.Candidate.RetainedSizeExplanation}}</div></td>
                <td><div class="leak-dominator">{{range .Candidate.DominatorPath}}<span>{{.}}</span>{{end}}</div><div class="muted">{{.Candidate.DominatorTreeExplanation}}</div><div class="leak-chain-summary">{{.Candidate.LeakChainSummary}}</div></td>
                <td>{{.Candidate.Recommendation}}<div class="leak-chain-actions"><strong>Быстрые проверки цепочки</strong>{{range .Candidate.LeakChainActions}}<span>{{.}}</span>{{end}}</div></td>
                <td><strong>{{.Candidate.EvidenceLabel}}</strong><div class="muted">Надёжность: {{conciseEvidenceConfidence .Candidate.EvidenceConfidence}}</div>{{.Candidate.Evidence}}</td>
              </tr>
              {{else}}<tr><td colspan="11" class="muted">В проверяемом прогоне нет признаков утечки памяти.</td></tr>{{end}}
            </tbody>
          </table>
        </div>
        {{end}}
      </div>
    </details>
    {{if .Math.Candidate.Summary.Influence.Available}}
    <h3>Граф влияния проверяемого прогона</h3>
    <p class="help-text">Здесь показаны самые важные классы. Полный граф открыт в отдельном HTML.</p>
    <table class="timeline-table">
      <tr><th>Класс</th><th>{{tip "Оценка" (scoreHelp "influence")}}</th><th>Риск</th><th>Статус</th><th>Причины</th></tr>
      {{range topInfluenceNodes .Math.Candidate.Summary.Influence 8}}
      <tr><td><code>{{.ClassName}}</code></td><td>{{printf "%.1f" .Score}}</td><td>{{influenceSeverity .Severity}}</td><td>{{influenceStatus .Status}}</td><td>{{join .Reasons ", "}}</td></tr>
      {{end}}
    </table>
    {{if .InfluenceReportHref}}<p class="help-text"><a href="{{.InfluenceReportHref}}">Открыть полный граф влияния</a></p>{{end}}
    {{end}}
    <h3>Сравнение операций и источников</h3>
    {{$contextRows := signalContextCompareRows .Math.Baseline.Summary .Math.Candidate.Summary}}
    <table class="timeline-table">
      <tr><th>Контекст</th><th>Проблемы базы</th><th>Проблемы проверяемого</th><th>Изменение проблем</th><th>Лишние логи базы</th><th>Лишние логи проверяемого</th><th>Изменение логов</th><th>p95 HTTP базы</th><th>p95 HTTP проверяемого</th><th>UI базы</th><th>UI проверяемого</th><th>Приоритет</th></tr>
      {{range $contextRows}}
      <tr>
        <td><code>{{signalContextHint .Screen .Operation .Owner}}</code></td>
        <td>{{.BaselineProblems}}</td><td>{{.CandidateProblems}}</td><td>{{.DeltaProblems}}</td>
        <td>{{.BaselineLogSpam}}</td><td>{{.CandidateLogSpam}}</td><td>{{.DeltaLogSpam}}</td>
        <td>{{.BaselineHTTPP95MS}} мс</td><td>{{.CandidateHTTPP95MS}} мс</td>
        <td>{{printf "%.2f" .BaselineJankPct}}%</td><td>{{printf "%.2f" .CandidateJankPct}}%</td>
        <td class="{{severityClass .Severity}}">{{severityLabel .Severity}}</td>
      </tr>
      {{else}}<tr><td colspan="12" class="muted">Нет контекстов операций для математического сравнения.</td></tr>{{end}}
    </table>
    {{if not .Math.CollectionLimits}}
    <h3>Что нужно проверить</h3>
    <div class="finding-list">
      {{range significantMathFindings .Math.Findings}}
      <div class="finding {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div>{{if .Recommendation}}<div class="muted">{{.Recommendation}}</div>{{end}}</div>
      {{else}}<div class="muted">Нет значимых предупреждений по качеству сравнения.</div>{{end}}
    </div>
    <h3 id="section-overview" class="section-overview-heading">Сводка разделов</h3>
    <div class="section-overview-grid">
      {{range .Math.Sections}}
      <a class="section-overview-card {{severityClass .Status}}" href="#{{.ID}}">
        <div class="section-overview-title"><span>{{.Title}}</span><span class="section-status {{severityClass .Status}}">{{statusLabel .Status}}</span></div>
        <div class="section-overview-summary">{{mathNarrative .Summary}}</div>
      </a>
      {{end}}
    </div>
    {{end}}
  </section>

  {{template "compare-data-quality" .Math}}

  {{$math := .Math}}
  {{range .Math.Sections}}
  <section id="{{.ID}}" class="panel{{if eq .ID "markov"}} markov-panel{{end}}">
    <div class="panel-head">
      <div><h2>{{.Title}}</h2><div class="panel-kicker">{{mathNarrative .Summary}}</div></div>
      <span class="section-status {{severityClass .Status}}">{{statusLabel .Status}}</span>
    </div>
    {{if eq .ID "markov"}}
    <div class="markov-forecast-grid">
      {{with $math.Baseline.Markov.Forecast}}
      <article class="markov-forecast {{severityClass .Severity}}" data-markov-forecast="{{.Direction}}">
        <div class="markov-forecast-copy">
          <div class="markov-forecast-heading"><span>Базовый прогон · проекция внутри записи</span><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></div>
          <strong class="markov-forecast-title">{{.Label}}</strong>
          <p>{{mathNarrative .Summary}}</p>
          <div class="markov-forecast-confidence">Поддержка модели: <strong>{{markovConfidence .Confidence}}</strong> · {{mathNarrative .ConfidenceReason}} · не калибровано как прогноз будущего запуска</div>
        </div>
        {{if .HorizonWindows}}
        <div class="markov-forecast-metrics">
          <div><span>Начало</span><strong>{{printf "%.1f" (percent01 .EarlyBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Последняя часть</span><strong>{{printf "%.1f" (percent01 .RecentBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Проекция</span><strong>{{printf "%.1f" (percent01 .ProjectedBadProbability)}}%</strong><small>модельная доля плохих состояний</small></div>
          <div><span>Горизонт</span><strong>{{.HorizonWindows}}</strong><small>интервалов · {{humanDuration .HorizonMS}}</small></div>
        </div>
        {{end}}
      </article>
      {{end}}
      {{with $math.Candidate.Markov.Forecast}}
      <article class="markov-forecast {{severityClass .Severity}}" data-markov-forecast="{{.Direction}}">
        <div class="markov-forecast-copy">
          <div class="markov-forecast-heading"><span>Проверяемый прогон · проекция внутри записи</span><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></div>
          <strong class="markov-forecast-title">{{.Label}}</strong>
          <p>{{mathNarrative .Summary}}</p>
          <div class="markov-forecast-confidence">Поддержка модели: <strong>{{markovConfidence .Confidence}}</strong> · {{mathNarrative .ConfidenceReason}} · не калибровано как прогноз будущего запуска</div>
        </div>
        {{if .HorizonWindows}}
        <div class="markov-forecast-metrics">
          <div><span>Начало</span><strong>{{printf "%.1f" (percent01 .EarlyBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Последняя часть</span><strong>{{printf "%.1f" (percent01 .RecentBadExposure)}}%</strong><small>плохих состояний · {{.SegmentWindows}} интервалов</small></div>
          <div><span>Проекция</span><strong>{{printf "%.1f" (percent01 .ProjectedBadProbability)}}%</strong><small>модельная доля плохих состояний</small></div>
          <div><span>Горизонт</span><strong>{{.HorizonWindows}}</strong><small>интервалов · {{humanDuration .HorizonMS}}</small></div>
        </div>
        {{end}}
      </article>
      {{end}}
    </div>
    {{end}}
    <details class="fold">
      <summary>{{if eq .ID "markov"}}Методика и наблюдения{{else}}Детали раздела{{end}}</summary>
      <div class="fold-body">
        <div class="finding-list">
          {{range significantMathFindings .Findings}}
          <div class="finding {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div>{{if .Recommendation}}<div class="muted">{{.Recommendation}}</div>{{end}}</div>
          {{else}}<div class="muted">Нет значимых предупреждений в этом разделе.</div>{{end}}
        </div>
        {{if eq .ID "timeline"}}
        <h3>Базовый прогон</h3>
        <div class="timeline-grid">
          {{range $math.Baseline.Series}}
          <div class="timeline-chart">
            <div class="timeline-chart-head"><div class="timeline-chart-title">{{.Name}}</div><div class="timeline-chart-value">макс. {{printf "%.1f" (seriesMax .)}} {{.Unit}}</div></div>
            {{sparkline .}}
          </div>
          {{else}}<div class="muted">Нет ненулевых рядов базы для отображения.</div>{{end}}
        </div>
        <h3>Проверяемый прогон</h3>
        <div class="timeline-grid">
          {{range $math.Candidate.Series}}
          <div class="timeline-chart">
            <div class="timeline-chart-head"><div class="timeline-chart-title">{{.Name}}</div><div class="timeline-chart-value">макс. {{printf "%.1f" (seriesMax .)}} {{.Unit}}</div></div>
            {{sparkline .}}
          </div>
          {{else}}<div class="muted">В проверяемом прогоне нет данных для графика.</div>{{end}}
        </div>
        {{end}}
        {{if eq .ID "robust"}}
        <h3>Устойчивое сравнение распределений</h3>
        {{range robustDeltaGroups $math.RobustDeltas}}
        <div class="category-block">
          <h4>{{.Title}}</h4>
          <table class="timeline-table">
            <tr><th>{{tip "Статус" "Автоматическая оценка направления изменения. Если направление неизвестно, статус остаётся нейтральным."}}</th><th>{{tip "Имя" "Маршрут, экран, источник или дополнительная метрика, для которых сравниваются две выборки."}}</th><th>{{tip "Метрика" "Измеряемая величина и её единица."}}</th><th>{{tip "N базы" "Число наблюдений в базе. При нуле распределения сравнить нельзя."}}</th><th>{{tip "N проверяемого" "Число наблюдений в проверяемом прогоне. Сильное различие N может означать разные сценарии."}}</th><th>{{tip "p95 базы" "Значение, быстрее которого завершились 95% наблюдений базы."}}</th><th>{{tip "p95 проверяемого" "Значение, быстрее которого завершились 95% наблюдений проверяемого прогона."}}</th><th>{{tip "Изменение p95" "p95 проверяемого прогона минус p95 базы."}}</th><th>{{tip "Изменение, %" "Изменение относительно базы. Не рассчитывается при нулевой базе или сигнале только в одном прогоне."}}</th><th>{{tip "Дельта Клиффа" "Размер различия распределений от −1 до 1. Это не вероятность ошибки."}}</th><th>{{tip "Эффект" "Размер различия по дельте Клиффа: пренебрежимый, малый, средний или большой."}}</th><th>{{tip "Надёжность" (scoreHelp "confidence")}}</th><th>{{tip "Вывод" "Краткий результат сравнения или причина, почему он не рассчитан."}}</th></tr>
            {{range .Items}}
            <tr>
              <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
              <td><code>{{.Name}}</code></td><td>{{.Metric}}</td><td>{{.BaselineCount}}</td><td>{{.CandidateCount}}</td>
              <td>{{if gt .BaselineCount 0}}{{printf "%.1f" .BaselineP95}} {{.Unit}}{{else}}<span class="muted">нет выборки</span>{{end}}</td><td>{{if gt .CandidateCount 0}}{{printf "%.1f" .CandidateP95}} {{.Unit}}{{else}}<span class="muted">нет выборки</span>{{end}}</td><td>{{printf "%+.1f" .P95Delta}} {{.Unit}}</td><td>{{if .DeltaPctAvailable}}{{printf "%+.1f" .P95DeltaPct}}%{{else}}<span class="muted">не применимо</span>{{end}}</td>
              <td>{{if .Comparable}}{{printf "%.3f" .CliffDelta}}{{else}}<span class="muted">не применимо</span>{{end}}</td><td>{{.EffectSize}}</td><td>{{.Confidence}}</td><td>{{mathNarrative .Summary}}</td>
            </tr>
            {{end}}
          </table>
        </div>
        {{else}}<div class="muted">Недостаточно данных для устойчивого сравнения распределений.</div>{{end}}
        <p class="muted">Положительная дельта Клиффа означает только то, что значения проверяемого прогона чаще больше базового. Для известных задержек, пауз и PSS это ухудшение; для пользовательской метрики направление неизвестно и автоматический вывод не делается.</p>
        {{end}}
        {{if eq .ID "change-points"}}
        <h3>Изменения точек изменения</h3>
        <p class="help-text">Точки сопоставляются по сигналу и близкому месту сценария: по времени либо по относительной позиции в прогоне. Это уменьшает ложные «новые точки», когда одинаковый шаг выполнялся с разной скоростью.</p>
        <table class="timeline-table">
          <tr><th>Статус</th><th>Сигнал</th><th>Время базы</th><th>Время проверяемого</th><th>{{tip "Оценка базы" (scoreHelp "change")}}</th><th>{{tip "Оценка проверяемого" (scoreHelp "change")}}</th><th>Вывод</th></tr>
          {{range $math.ChangeDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{.Status}}</span></td><td>{{.Signal}}</td>
            <td>{{if .BaselineTime}}{{printf "%.1fs" (seconds .BaselineTime)}}{{else}}-{{end}}</td>
            <td>{{if .CandidateTime}}{{printf "%.1fs" (seconds .CandidateTime)}}{{else}}-{{end}}</td>
            <td>{{printf "%.2f" .BaselineScore}}</td><td><div>{{printf "%.2f" .CandidateScore}}</div><div class="bar"><i style="{{scoreWidth .CandidateScore}}"></i></div></td>
            <td>{{mathNarrative .Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="7" class="muted">Новых, исчезнувших или усилившихся точек изменения не найдено.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "periodic"}}
        <h3>Базовый прогон</h3>
        <table class="timeline-table">
          <tr><th>Сигнал</th><th>{{tip "N" "Самый длинный непрерывный участок с измерениями; ниже показано покрытие всего ряда. Пропуски не заменяются нулями."}}</th><th>{{tip "Первый лаг" "Первый сдвиг с автокорреляцией от 0.60. Отсутствие значения означает, что этот тест не подтвердил повторяемость."}}</th><th>{{tip "Энтропия" "Ближе к 0 - стабильный ритм, ближе к 1 - шум. Энтропия не показывает важность проблемы."}}</th><th>{{tip "Пики" "Показаны пики минимум втрое выше фона и с достаточной надёжностью."}}</th><th>Вывод</th></tr>
          {{range $math.Baseline.Periodic}}
          <tr><td>{{.Signal}}</td><td>{{.SampleCount}}<div class="muted">измерено {{.ObservedBucketCount}} из {{.TotalBucketCount}}</div>{{if .Approximated}}<div class="muted">спектр: {{.AnalyzedSampleCount}}, шаг {{printf "%.1fs" (seconds .AnalysisBucketMS)}}</div>{{end}}</td><td>{{if .FirstSignificantLagMS}}{{printf "%.1fs" (seconds .FirstSignificantLagMS)}}{{else}}<span class="muted">не подтвержден</span>{{end}}</td><td>{{if ge .SampleCount 12}}{{printf "%.2f" .SpectralEntropy}}{{else}}<span class="muted">не рассчитана</span>{{end}}</td><td>{{range .Peaks}}<div>{{printf "%.1fs" (seconds .PeriodMS)}} · надёжность {{printf "%.2f" .Confidence}}</div>{{else}}<span class="muted">нет подтвержденных</span>{{end}}</td><td>{{mathNarrative .Summary}}</td></tr>
          {{else}}<tr><td colspan="6" class="muted">Недостаточно данных базы.</td></tr>{{end}}
        </table>
        <h3>Проверяемый прогон</h3>
        <table class="timeline-table">
          <tr><th>Сигнал</th><th>{{tip "N" "Самый длинный непрерывный участок с измерениями; ниже показано покрытие всего ряда."}}</th><th>{{tip "Первый лаг" "Первый сдвиг с автокорреляцией от 0.60."}}</th><th>{{tip "Энтропия" "Ближе к 0 - стабильный ритм, ближе к 1 - шум. Это не оценка важности проблемы."}}</th><th>{{tip "Пики" "Слабые пики, похожие на фон, скрываются."}}</th><th>Вывод</th></tr>
          {{range $math.Candidate.Periodic}}
          <tr><td>{{.Signal}}</td><td>{{.SampleCount}}<div class="muted">измерено {{.ObservedBucketCount}} из {{.TotalBucketCount}}</div>{{if .Approximated}}<div class="muted">спектр: {{.AnalyzedSampleCount}}, шаг {{printf "%.1fs" (seconds .AnalysisBucketMS)}}</div>{{end}}</td><td>{{if .FirstSignificantLagMS}}{{printf "%.1fs" (seconds .FirstSignificantLagMS)}}{{else}}<span class="muted">не подтвержден</span>{{end}}</td><td>{{if ge .SampleCount 12}}{{printf "%.2f" .SpectralEntropy}}{{else}}<span class="muted">не рассчитана</span>{{end}}</td><td>{{range .Peaks}}<div>{{printf "%.1fs" (seconds .PeriodMS)}} · надёжность {{printf "%.2f" .Confidence}}</div>{{else}}<span class="muted">нет подтвержденных</span>{{end}}</td><td>{{mathNarrative .Summary}}</td></tr>
          {{else}}<tr><td colspan="6" class="muted">В проверяемом прогоне недостаточно данных.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "network-loops"}}
        <h3>Изменения повторяющихся сетевых запросов</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Новая, исчезнувшая, усилившаяся или ослабевшая последовательность повторных запросов."}}</th><th>{{tip "Маршрут" "Сетевой маршрут повторных запросов. Пустое значение означает, что маршрут определить не удалось."}}</th><th>{{tip "Источник" "Источник сетевой работы. Это место для проверки, а не доказанная причина."}}</th><th>{{tip "Период базы" "Обычное расстояние между всплесками в базе."}}</th><th>{{tip "Период проверяемого" "Обычное расстояние между всплесками в проверяемом прогоне."}}</th><th>{{tip "Нагрузка базы" (scoreHelp "network_burn")}}</th><th>{{tip "Нагрузка проверяемого" (scoreHelp "network_burn")}}</th><th>{{tip "Изменение нагрузки" "Условная нагрузка проверяемого прогона минус база. Это не время, байты или энергия."}}</th><th>{{tip "Изменение надёжности" "Изменение числа признаков повторяемого поведения. Это не вероятность ошибки."}}</th><th>{{tip "Вывод" "Что изменилось и какие ограничения есть у проверки."}}</th></tr>
          {{range $math.NetworkLoopDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{.Status}}</span></td>
            <td>{{if .Route}}<code>{{.Route}}</code>{{else}}<span class="muted">нет</span>{{end}}</td>
            <td>{{if .Owner}}<code>{{contextHint .Owner "owner"}}</code>{{else}}<span class="muted">нет</span>{{end}}</td>
            <td>{{if .BaselinePeriodMS}}{{printf "%.1fs" (seconds .BaselinePeriodMS)}}{{else}}-{{end}}</td>
            <td>{{if .CandidatePeriodMS}}{{printf "%.1fs" (seconds .CandidatePeriodMS)}}{{else}}-{{end}}</td>
            <td>{{printf "%.1f" .BaselineBurn}}</td>
            <td>{{printf "%.1f" .CandidateBurn}}</td>
            <td>{{printf "%+.1f" .BurnDelta}}</td>
            <td>{{printf "%+.2f" .ConfidenceDelta}}</td>
            <td>{{mathNarrative .Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="10" class="muted">Заметных изменений повторных сетевых запросов не найдено.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "integral"}}
        <h3>Дельты интегральных оценок</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Регрессия рассчитывается только для похожей длительности и одинакового числа независимых прогонов."}}</th><th>{{tip "Оценка" (scoreHelp "integral")}}</th><th>{{tip "База" "Накопленное значение, длительность и число прогонов базы."}}</th><th>{{tip "Проверяемый" "Накопленное значение, длительность и число проверяемых прогонов."}}</th><th>{{tip "Изменение" "Проверяемый прогон минус база, в единице конкретной оценки."}}</th><th>{{tip "Изменение, %" "Процент относительно базы. Не показывается при нулевой базе, разном числе прогонов или различии длительности больше 20%."}}</th><th>{{tip "Критерии" "Рабочие границы статуса, а не SLA продукта."}}</th><th>{{tip "Формула" "Правило расчёта. У каждой строки своя единица; Σ означает сумму по временным интервалам."}}</th><th>{{tip "Вывод" "Объяснение изменения или причина, почему результат не рассчитан."}}</th></tr>
          {{range $math.IntegralDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Title}}</td>
            <td>{{printf "%.1f" .BaselineValue}} {{.Unit}}<div class="muted">{{printf "%.1fs" (seconds .BaselineDurationMS)}} · групп сбора {{if gt .BaselineRunCount 0}}{{.BaselineRunCount}}{{else}}1{{end}}</div></td>
            <td>{{printf "%.1f" .CandidateValue}} {{.Unit}}<div class="muted">{{printf "%.1fs" (seconds .CandidateDurationMS)}} · групп сбора {{if gt .CandidateRunCount 0}}{{.CandidateRunCount}}{{else}}1{{end}}</div></td>
            <td>{{printf "%+.1f" .Delta}} {{.Unit}}</td>
            <td>{{if .DeltaPctAvailable}}{{printf "%+.1f" .DeltaPct}}%{{else}}<span class="muted">не применимо</span>{{end}}</td>
            <td>{{integralCriteria .ID}}</td>
            <td><code>{{.Formula}}</code></td>
            <td>{{mathNarrative .Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="9" class="muted">Интегральные дельты недоступны.</td></tr>{{end}}
        </table>
        <p class="help-text">Накопленные оценки зависят от длительности. При разных сценариях или времени работы изменение описывает только эти прогоны и не доказывает регрессию кода.</p>
        {{end}}
        {{if eq .ID "markov"}}
        <h3>Дельты марковских метрик</h3>
        <table class="timeline-table">
          <tr><th>{{tip "Статус" "Предупреждение означает ухудшение метрики или невозможность честно сравнить последовательности."}}</th><th>{{tip "Метрика" "Характеристика модели состояний: доля плохих состояний, восстановление, переходы или различие матриц."}}</th><th>{{tip "База" "Значение метрики в базовом прогоне."}}</th><th>{{tip "Проверяемый" "Значение той же метрики в проверяемом прогоне."}}</th><th>{{tip "Изменение" "Проверяемый прогон минус база. Колонка «Вывод» показывает, какое направление хуже."}}</th><th>{{tip "Вывод" "Направление изменения или причина, почему результат не рассчитан."}}</th></tr>
          {{range significantMarkovDeltas $math.MarkovDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Metric}}</td>
            <td>{{if .BaselineAvailable}}{{printf "%.1f" .BaselineValue}} {{.Unit}}{{else}}<span class="muted">нет данных</span>{{end}}</td>
            <td>{{if .CandidateAvailable}}{{printf "%.1f" .CandidateValue}} {{.Unit}}{{else}}<span class="muted">нет данных</span>{{end}}</td>
            <td>{{if .Comparable}}{{printf "%+.1f" .Delta}} {{.Unit}}{{else}}<span class="muted">не применимо</span>{{end}}</td>
            <td>{{mathNarrative .Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="6" class="muted">Нет значимых марковских дельт.</td></tr>{{end}}
          {{if hiddenMarkovDeltas $math.MarkovDeltas}}<tr><td colspan="6" class="muted">Скрыто спокойных марковских дельт: {{hiddenMarkovDeltas $math.MarkovDeltas}}.</td></tr>{{end}}
        </table>
        <h3>Доля плохих состояний проверяемого прогона</h3>
        <table class="timeline-table">
          <tr><th>Состояние</th><th>{{tip "Доля времени" "Доля проверяемого прогона в этом плохом состоянии."}}</th><th>Длительность</th><th>Интервалы</th></tr>
          {{range $math.Candidate.Markov.StateExposures}}
          <tr><td>{{markovState .State}}</td><td>{{printf "%.1f" (percent01 .Exposure)}}%</td><td>{{humanDuration .DurationMS}}</td><td>{{.Windows}}</td></tr>
          {{else}}<tr><td colspan="4" class="muted">В проверяемом прогоне нет плохих состояний.</td></tr>{{end}}
        </table>
        <h3>Повторение проблемных состояний проверяемого прогона</h3>
        <table class="timeline-table">
          <tr><th>Состояние</th><th>Контекст</th><th>{{tip "Количество" "Число самопереходов плохого состояния рядом с этим контекстом."}}</th><th>{{tip "Вероятность" "Наблюдаемая доля самопереходов. На малой выборке нестабильна и не является общей вероятностью бага."}}</th></tr>
          {{if $math.Candidate.Markov.SequenceComparable}}{{range $math.Candidate.Markov.ContextStickyStates}}
          <tr><td>{{markovState .State}}</td><td>{{.Context}}</td><td>{{.Count}}</td><td>{{printf "%.1f" (percent01 .Probability)}}%</td></tr>
          {{else}}<tr><td colspan="4" class="muted">В проверяемом прогоне нет контекстов с долгим восстановлением.</td></tr>{{end}}{{else}}<tr><td colspan="4" class="muted">Не рассчитывается для нескольких объединённых прогонов.</td></tr>{{end}}
        </table>
        <h3>Переходы проверяемого прогона</h3>
        <table class="timeline-table">
          <tr><th>Из</th><th>В</th><th>{{tip "Количество" "Число переходов между соседними интервалами проверяемого прогона."}}</th><th>{{tip "Вероятность" "Доля этого перехода среди всех переходов из исходного состояния."}}</th></tr>
          {{if $math.Candidate.Markov.SequenceComparable}}{{range significantMarkovTransitions $math.Candidate.Markov.Transitions}}
          <tr><td>{{markovState .From}}</td><td>{{markovState .To}}</td><td>{{.Count}}</td><td>{{printf "%.1f" (percent01 .Probability)}}%</td></tr>
          {{else}}<tr><td colspan="4" class="muted">Нет значимых переходов между плохими состояниями.</td></tr>{{end}}
          {{if hiddenMarkovTransitions $math.Candidate.Markov.Transitions}}<tr><td colspan="4" class="muted">Скрыто спокойных переходов: {{hiddenMarkovTransitions $math.Candidate.Markov.Transitions}}.</td></tr>{{end}}{{else}}<tr><td colspan="4" class="muted">Хронологические переходы не рассчитываются для нескольких объединённых прогонов.</td></tr>{{end}}
        </table>
        {{end}}
        {{if eq .ID "graph"}}
        <h3>Граф связей проверяемого прогона</h3>
        <p class="help-text">Линии показывают совместные наблюдения без направления причины. Обратные дубликаты скрыты.</p>
        {{causalGraphSVG $math.Candidate.CausalGraph}}
        <h3>Изменения графа связей и гипотез</h3>
        <table class="timeline-table">
          <tr><th>Статус</th><th>Тип изменения</th><th>{{tip "База" "Значение зависит от строки: надёжность связи, условная стоимость цепочки или оценка источника. Это не физическая величина."}}</th><th>{{tip "Проверяемый" "Сопоставимое условное значение проверяемого прогона."}}</th><th>Изменение</th><th>Вывод и ограничение</th></tr>
          {{range $math.CausalDeltas}}
          <tr>
            <td><span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span></td>
            <td>{{.Kind}}</td>
            <td>{{printf "%.2f" .BaselineValue}}</td>
            <td>{{printf "%.2f" .CandidateValue}}</td>
            <td>{{printf "%+.2f" .Delta}}</td>
            <td>{{mathNarrative .Summary}}</td>
          </tr>
          {{else}}<tr><td colspan="6" class="muted">Заметных изменений графа не найдено.</td></tr>{{end}}
        </table>
        <h3>Цепочки от симптомов проверяемого прогона</h3>
        <table class="timeline-table">
          <tr><th>Симптом</th><th>Контекст</th><th>Цепочка связей</th><th>{{tip "Условная стоимость" (scoreHelp "path_cost")}}</th><th>{{tip "Надёжность" "Сила цепочки совместных наблюдений. Это не вероятность причины."}}</th></tr>
          {{range $math.Candidate.CausalGraph.Paths}}
          <tr><td>{{.From}}</td><td>{{.To}}</td><td>{{join .Nodes " ↔ "}}</td><td>{{printf "%.2f" .Cost}}</td><td>{{printf "%.2f" .Confidence}}</td></tr>
          {{else}}<tr><td colspan="5" class="muted">Пути от симптомов к коду не найдены.</td></tr>{{end}}
        </table>
        {{end}}
      </div>
    </details>
  </section>
  {{end}}
  <section id="method-reference" class="panel">
    <div class="panel-head">
      <div>
        <h2>Справка по методам</h2>
        <div class="panel-kicker">Что измеряет каждый метод, как считается результат и как читать изменения между прогонами.</div>
      </div>
      <span class="pill">объяснимость</span>
    </div>
    <div class="method-reference-grid">
      {{range .MethodReferences}}
      <details class="fold method-reference-card" id="method-{{.ID}}">
        <summary><span>{{.Title}}</span><span class="method-kind">{{.Kind}}</span></summary>
        <div class="fold-body">
          <div class="reference-block"><strong>Что измеряет</strong>{{.Measures}}</div>
          <div class="reference-block"><strong>Где применяется</strong>{{.AppliesTo}}</div>
          <div class="reference-block"><strong>Как считается</strong>{{.Calculation}}</div>
          <div class="reference-block"><strong>Как читать</strong>{{.Interpretation}}</div>
          <div class="reference-block"><strong>Ограничения</strong>{{.Limitations}}</div>
          <div class="reference-block"><strong>Поля в inspect</strong><div class="reference-list">{{range .InspectFields}}<code>{{.}}</code>{{end}}</div></div>
          <div class="reference-block"><strong>Поля при сравнении</strong><div class="reference-list">{{range .CompareFields}}<code>{{.}}</code>{{end}}</div></div>
        </div>
      </details>
      {{end}}
    </div>
  </section>
  {{if not .Math.CollectionLimits}}
  {{with compareMathHeuristic .Math}}
  <section id="math-verdict" class="panel">
    <div class="panel-head">
      <div>
        <h2>Итог автоматической проверки</h2>
        <div class="panel-kicker">Общий риск проверяемого прогона, главные факторы и первый шаг проверки.</div>
      </div>
      <span class="section-status {{severityClass .Severity}}">{{statusLabel .Severity}}</span>
    </div>
    <div class="analysis-banner {{severityClass .Severity}}">
      <div class="eyebrow">Общий вывод</div>
      <div class="analysis-status">{{.Status}}</div>
      <div class="muted">{{mathNarrative .Summary}}</div>
    </div>
    <div class="heuristic-grid">
      {{range .Cards}}
      <div class="heuristic-card {{severityClass .Severity}}"><strong>{{.Title}}</strong><div class="muted">{{.Detail}}</div></div>
      {{end}}
    </div>
  </section>
  {{end}}
  {{end}}
</main>
<script>{{reportJS}}
(() => {
  const links = Array.from(document.querySelectorAll('.math-page .nav a'));
  const setActive = (hash) => {
    links.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === hash));
  };
  links.forEach((link) => link.addEventListener('click', () => setActive(link.getAttribute('href'))));
  if (location.hash) setActive(location.hash);
  const sections = links.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActive('#' + visible.target.id);
    }, { rootMargin: '-20% 0px -65% 0px', threshold: [0.1, 0.3, 0.6] });
    sections.forEach((section) => observer.observe(section));
  }
})();
</script>
</body>
</html>
